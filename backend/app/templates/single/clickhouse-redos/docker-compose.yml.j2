clickhouse-redos:
    image: {{ registry_url or 'dh-mirror.gitverse.ru/clickhouse/clickhouse-server:24.3' }}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8123/ping"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 30s
{% if config.get('ports') %}
    ports:
{% for ext, intv in config['ports'].items() %}
      - "{{ ext }}:{{ intv }}"
{% endfor %}
{% endif %}
    environment:
      TZ: "{{ config.get('env', {}).get('TZ', 'Europe/Moscow') }}"
{% if config.get('volumes') %}
    volumes:
{% for host, container in config['volumes'].items() %}
      - {{ host }}:{{ container }}
{% endfor %}
{% else %}
    volumes:
      - clickhouse-data:/var/lib/clickhouse
{% endif %}
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    networks:
      - gosdocker
