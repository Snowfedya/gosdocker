  postgresql-redos:
    image: {{ registry_url or 'registry.red-soft.ru/ubi8/postgresql-17' }}
    container_name: postgresql-redos
    restart: unless-stopped
{% if config.get('ports') %}
    ports:
{% for ext, intv in config['ports'].items() %}
      - "{{ ext }}:{{ intv }}"
{% endfor %}
{% endif %}
    environment:
      POSTGRESQL_DATABASE: gosdocker
      POSTGRESQL_USER: gosdocker
      POSTGRESQL_PASSWORD: {{ config.get('env', {}).get('POSTGRES_PASSWORD', 'changeme') }}
{% if config.get('env', {}).get('TZ') %}
      TZ: "{{ config.get('env', {}).get('TZ') }}"
{% endif %}
{% if config.get('volumes') %}
    volumes:
{% for host, container in config['volumes'].items() %}
      - {{ host }}:{{ container }}
{% endfor %}
{% else %}
    volumes:
      - pgdata-redos:/var/lib/postgresql/data
{% endif %}
    networks:
      - gosdocker
